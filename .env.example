# Model & Paths
MODEL_PATH=weights/best.pt
OUTPUTS_DIR=outputs
TMP_DIR=tmp

# Detection defaults
CONF_DEFAULT=0.35
LOG_LEVEL=info
PREVIEW_STRATEGY=max_unhelmet_then_conf

# Runtime
TZ=Asia/Bangkok
ALLOW_ORIGINS=https://your-ngrok-url.dev

# Google Drive - OAuth Configuration
GDRIVE_ENABLED=1
GDRIVE_CREDENTIALS_PATH=credentials/oauth-client.json
GDRIVE_TOKEN_PATH=credentials/token.pickle
GDRIVE_PARENT_FOLDER_ID=your_folder_id_here

# Frame saving behavior
PREVIEW_ONLY_ONE=0
SAVE_ONLY_MIXED=0
SAVE_FRAMES_WITH_HELMET=1
SAVE_FRAMES_WITHOUT_HELMET=1

# Output retention
OUTPUT_RETENTION_DAYS=7

# เพิ่มตัวแปรเหล่านี้
MAX_SAVED_FRAMES=20
FRAME_STRIDE=5  # ลด stride เพื่อให้ได้เฟรมมากขึ้น